# ============================================================
# KrishiSetu AI — local environment config (copy to .env)
#   cp .env.example .env
# ============================================================

# ---- Ollama (Windows desktop app, runs on localhost:11434) ----
# OLLAMA_HOST tells the Python/Chromadb stack where the Ollama server lives.
# On Windows the Ollama app binds 127.0.0.1:11434 by default — keep this.
OLLAMA_HOST=http://localhost:11434
# Base URL consumed by LangChainOllama / ChatOllama / OllamaEmbeddings.
# Note the trailing slash is NOT included (LangChain appends routes itself).
OLLAMA_BASE_URL=http://localhost:11434

# ---- Which Ollama models to use (pull via PowerShell, see SETUP.md) ----
# Current best open-source, free, locally-runnable picks for this laptop
# (RTX 4050 6 GB VRAM, 24 GB RAM — multilingual Hindi/English agriculture):
OLLAMA_LLM_MODEL=qwen3.5:4b             # Tier-4 paraphrasing LLM (Q4, ~3.4GB, strong Hindi, fits VRAM)
OLLAMA_LLM_FALLBACK=qwen3.5:2b          # light fallback LLM (fast, ~2.7GB)
# Optional higher-quality Tier-4 paraphraser if you accept some GPU->CPU offload:
#   OLLAMA_LLM_MODEL=qwen3.5:9b         (~6.6GB, best local quality; slower on a 6GB GPU)
OLLAMA_EMBEDDING_MODEL=bge-m3:567m      # multilingual embedding (100+ langs, 1024-d)

# ---- ChromaDB persistent path (local vector store) ----
# Absolute path recommended on Windows to avoid drive/working-dir surprises.
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=krishisethu_kvk

# ---- Retrieval tuning (safe-by-construction defaults) ----
RAG_TOP_K=5                       # hard cap from the white paper
CONFIDENCE_GATE=0.85              # composite confidence gate
CONFIDENCE_W_RULE=0.50            # w1 rule-engine score
CONFIDENCE_W_RAG=0.30             # w2 RAG score
CONFIDENCE_W_VISION=0.20          # w3 vision score (0 until vision online)

# ---- FastAPI ----
APP_HOST=127.0.0.1
APP_PORT=8000

# --- Cloud LLM Routing Keys (HybridRenderer) ---
# Up to 10 cloud keys are pooled and rolled over automatically; any key left
# blank is skipped. If none are set (or all fail), HybridRenderer falls back to
# the local Ollama models above.

# NVIDIA NIM (https://build.nvidia.com) - 4 slots
#NVIDIA_API_KEY_1=
#NVIDIA_API_KEY_2=
#NVIDIA_API_KEY_3=
#NVIDIA_API_KEY_4=

# Groq Cloud (https://console.groq.com) - 4 slots
#GROQ_API_KEY_1=
#GROQ_API_KEY_2=
#GROQ_API_KEY_3=
#GROQ_API_KEY_4=

# OpenRouter / Other Cloud (https://openrouter.ai) - 2 slots
#OPENROUTER_API_KEY_1=
#OPENROUTER_API_KEY_2=
